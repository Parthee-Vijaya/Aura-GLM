{
  "name": "ai-harness-desktop",
  "version": "0.2.0-beta.1",
  "private": true,
  "description": "Byg applikationer med AI, lokale projektfiler og forhåndsvisning",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:desktop": "node scripts/verify-desktop.cjs",
    "test:agent": "node scripts/verify-agent.cjs",
    "test:chat": "node scripts/verify-chat.cjs",
    "test:live": "node scripts/verify-live-agent.cjs",
    "test:setup": "node scripts/verify-setup.cjs",
    "test:hosting": "node scripts/verify-hosting.cjs",
    "test:openrouter": "node scripts/verify-live-openrouter.cjs",
    "test:preferences": "node scripts/verify-preferences.cjs",
    "test:deployment": "node scripts/verify-deployment.cjs",
    "test:introduction": "node scripts/verify-introduction.cjs",
    "runtime:prepare": "node scripts/prepare-runtime.cjs",
    "package:mac": "electron-builder --config electron-builder.cjs --mac --publish never",
    "package:windows": "electron-builder --config electron-builder.cjs --win --publish never",
    "test:package": "node scripts/verify-package.cjs",
    "release:site": "node scripts/release-site.cjs",
    "test:resume": "node scripts/verify-resume.cjs",
    "test:frameworks": "node scripts/verify-framework-preview.cjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "dugite": "3.2.3",
    "electron": "44.4.4",
    "electron-builder": "26.16.1",
    "playwright": "1.63.0"
  },
  "author": "AI Alliancen"
}
