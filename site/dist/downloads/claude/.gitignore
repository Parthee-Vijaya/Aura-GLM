# Sammenflet med projektets eksisterende .gitignore; overskriv den ikke.
# Allerede sporede filer påvirkes ikke af disse regler.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.*.example
*.key
*.p12
*.pfx
.secrets/
node_modules/
.venv/
__pycache__/
.DS_Store
Thumbs.db
*.log

# Instruktionsfiler og låsefiler skal kunne versionsstyres.
